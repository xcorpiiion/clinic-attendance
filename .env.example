# Copie para .env e ajuste só o que precisar; todos têm valor padrão no docker-compose.yml.

# Portas no host
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306

# Serviço que fornece o protocolo. Para simular falhas:
#   https://httpbin.org/status/500   erro no serviço
#   https://httpbin.org/delay/10     resposta além do timeout de leitura (5s)
PROTOCOL_URL=https://httpbin.org/uuid
